# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# Ollama Configuration (fallback if local model not available)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:9b

# Text-only local model (used for pitch generation — faster)
LOCAL_MODEL_PATH=/home/pranavvv/models/qwen3.5-9b/Qwen3.5-9B-Q4_K_M.gguf

# VLM model directory (used for vision tasks — contains .gguf + mmproj)
VLM_MODEL_DIR=/home/pranavvv/models/qwen3.5-VLM-9b
VLM_MODEL_FILE=Qwen3.5-9B-Q4_K_M.gguf
VLM_MMPROJ_FILE=mmproj-F16.gguf

# Proxy (optional — for Google Maps scraping)
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Database
DB_PATH=./data/leads.db

# WhatsApp Web persistent session directory
WHATSAPP_USER_DATA_DIR=./whatsapp_session

# Dashboard
DASHBOARD_PORT=8080

# LLM Provider (local, openai, anthropic, ollama)
LLM_PROVIDER=local

# OpenAI API Key (optional — for cloud pitch generation)
OPENAI_API_KEY=

# Anthropic API Key (optional — for cloud pitch generation)
ANTHROPIC_API_KEY=
