{
  "id": "real_estate_agent",
  "name": "Real Estate Agent",
  "version": "1.0.0",
  "author": "acquirec-team",
  "description": "Find real estate agencies that need better digital tools",
  "target": {
    "categories": ["real_estate", "property_management", "interior_design"],
    "cities": ["auto_rotate"],
    "countries": ["IN", "US", "UK", "AU"]
  },
  "scrapers": ["google_maps", "yellow_pages"],
  "pain_points": {
    "detectors": [
      {"id": "no_virtual_tours", "weight": 1.0},
      {"id": "no_crm", "weight": 0.9},
      {"id": "poor_listings", "weight": 0.8}
    ]
  },
  "pitch": {
    "tone": "professional_assertive",
    "max_length": 1200,
    "must_include": ["listings", "virtual tour", "leads"],
    "system_prompt": "You are a proptech consultant helping real estate agencies modernize their digital presence."
  },
  "follow_up": {
    "sequence": "b2b_enterprise",
    "channels": ["email"]
  }
}
